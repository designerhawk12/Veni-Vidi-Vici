GUARDIAN_API_ENABLED=true
GUARDIAN_API_TARGET=http://127.0.0.1:8000
GUARDIAN_ALLOWED_RECIPIENT_DOMAINS=example.test,vendor.test
OWNER_TOKEN=replace-with-a-random-owner-token-at-least-32-chars
INVITATIONS_TOKEN=replace-with-a-random-invitations-token-32
CATERING_TOKEN=replace-with-a-random-catering-token-at-least-32
VENDOR_TOKEN=replace-with-a-random-vendor-token-at-least-32-chars
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=guardian@example.test
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
GEMINI_API_KEY=
GUARDIAN_ALLOW_PUBLIC_NETWORK=false
GUARDIAN_PRODUCTION_TLS=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
IMAP_TIMEOUT_SECONDS=10
IMAP_POLL_INTERVAL_SECONDS=60
CADDY_DOMAIN=events.example.com
